generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  FACILITY_ADMIN
  CLUB_LEADER
  PLAYER
}

enum OperatorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// 계정 사용 가능 상태. ACTIVE = 정상 사용. PENDING = 운영자 회원가입 후 최고관리자
// 승인 대기(앱 사용 차단). REJECTED = 신청 거절됨. 기존/일반(카톡·QR) 유저는 기본
// ACTIVE 라 승인 흐름의 영향을 받지 않는다.
enum AccountStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum CourtStatus {
  EMPTY
  IN_USE
  MAINTENANCE
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TurnStatus {
  WAITING
  PLAYING
  COMPLETED
  CANCELLED
}

enum SkillLevel {
  S // 선수출신
  A // 상
  B // 중상
  C // 중
  D // 중하
  E // 초심
  F // 왕초심
}

enum GameType {
  SINGLES
  DOUBLES
  MIXED_DOUBLES
}

enum CourtGameType {
  DOUBLES
  LESSON
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum ClubMemberRole {
  LEADER
  STAFF
  MEMBER
}

enum ClubSessionStatus {
  ACTIVE
  ENDED
}

enum ChatMessageType {
  CHAT
  REQUEST
}

model User {
  id            String   @id @default(uuid())
  phone         String?  @unique
  password      String?
  kakaoId       String?  @unique
  googleId      String?  @unique
  name          String
  role          UserRole @default(PLAYER)
  // 계정 상태. 운영자 회원가입(관리자 신청)으로 만들어진 계정은 PENDING 으로 시작해
  // 최고관리자 승인 전까지 앱 사용이 차단된다. 그 외 모든 경로(카톡/구글/전화 로그인,
  // QR·초대코드 가입)는 기본 ACTIVE.
  accountStatus AccountStatus @default(ACTIVE)
  isGuest       Boolean  @default(false)
  // Operator-managed club member: a real, PERSISTENT club member with no app
  // login (운영자가 등록한 멤버). Unlike a session guest (isGuest=true, vanishes
  // when the 정모 ends), a managed member keeps its ClubMember row and shows in
  // the roster across 정모s. The operator just takes attendance each 정모.
  isManaged     Boolean  @default(false)
  expoPushToken String?
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  facilityAdmins      FacilityAdmin[]
  checkIns            CheckIn[]
  clubMembers         ClubMember[]
  gamePlayers         GamePlayer[]
  notifications       Notification[]
  profile             PlayerProfile?
  noShowRecords       NoShowRecord[]
  openedSessions      FacilitySession[]   @relation("SessionOpener")
  createdTurns        CourtTurn[]         @relation("TurnCreator")
  turnPlayers         TurnPlayer[]
  startedClubSessions ClubSession[]       @relation("ClubSessionStarter")
  createdGameBoards   GameBoard[]         @relation("GameBoardCreator")
  clubMessages        ClubMessage[]
  operatorRequests    OperatorRequest[]   @relation("OperatorRequester")
}

// 운영자(모임 생성 권한) 신청. PLAYER 가 운영자 권한을 신청하면 SUPER_ADMIN 이
// 승인/거절한다. 승인 시 해당 User.role 이 CLUB_LEADER 로 바뀐다. 한 유저는
// 동시에 PENDING 신청을 하나만 가질 수 있다(코드에서 enforce).
model OperatorRequest {
  id           String                @id @default(uuid())
  userId       String
  status       OperatorRequestStatus @default(PENDING)
  message      String?
  // 운영자 회원가입(관리자 신청) 경로에서 채워지는 신청 정보. 신청자가 운영하려는
  // 모임 이름과 활동 지역/장소. 기존 인앱 "운영자 신청"(PLAYER→CLUB_LEADER)에는 null.
  clubName     String?
  region       String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime              @default(now())

  user User @relation("OperatorRequester", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model PlayerProfile {
  id                 String     @id @default(uuid())
  userId             String     @unique
  skillLevel         SkillLevel?
  preferredGameTypes GameType[] @default([DOUBLES])
  gender             String?
  birthYear          Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Facility {
  id         String   @id @default(uuid())
  name       String
  address    String
  latitude   Float?
  longitude  Float?
  qrCodeData String   @unique @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  courts        Court[]
  admins        FacilityAdmin[]
  checkIns      CheckIn[]
  policy        FacilityPolicy?
  noShowRecords NoShowRecord[]
  sessions      FacilitySession[]
  homeClubs     Club[]
  clubSessions  ClubSession[]
  gameBoards    GameBoard[]
}

model FacilityPolicy {
  id                   String   @id @default(uuid())
  facilityId           String   @unique
  maxTurnsPerCourt     Int      @default(3)
  playersPerTurn       Int      @default(4)
  allowRequeue         Boolean  @default(true)
  noShowPenaltyMinutes Int      @default(30)
  turnNotifyEnabled    Boolean  @default(true)
  gameDurationMinutes  Int?
  gameWarningMinutes   Int?     @default(2)
  checkinRadiusM       Int      @default(100)
  checkinWindowMinutes Int?     @default(60)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model Court {
  id            String        @id @default(uuid())
  name          String
  facilityId    String
  // Per-정모 ownership. A court belongs to ONE ClubSession (코트1·2·3 등). Each 정모
  // names its own courts independently and never sees another 정모's courts.
  // clubSessionId = null → a facility-level court (facility-admin dashboard).
  clubSessionId String?
  status        CourtStatus   @default(EMPTY)
  gameType      CourtGameType @default(DOUBLES)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  facility         Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  clubSession      ClubSession?     @relation(fields: [clubSessionId], references: [id], onDelete: Cascade)
  turns            CourtTurn[]
  games            Game[]
  gameBoardEntries GameBoardEntry[]

  // Each 정모 names its courts independently (코트1·2·3) — same names across 정모s
  // never collide. Facility-level courts (clubSessionId = null) are not constrained
  // by this composite (null sessions don't participate in the unique).
  @@unique([clubSessionId, name])
  @@index([clubSessionId])
}

model FacilityAdmin {
  id         String @id @default(uuid())
  userId     String
  facilityId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
}

model CheckIn {
  id            String    @id @default(uuid())
  userId        String
  facilityId    String
  clubSessionId String?
  checkInLat    Float?
  checkInLng    Float?
  feeAmount     Int? // guest fee in KRW, null for members / no-fee
  feePaid       Boolean   @default(false)
  checkedInAt   DateTime  @default(now())
  checkedOutAt  DateTime?
  restingAt     DateTime?
  isInLesson    Boolean   @default(false) // 레슨 중: 자동추천/풀에서 제외, 수동으로만 코트 배정

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  clubSession ClubSession? @relation(fields: [clubSessionId], references: [id], onDelete: SetNull)

  @@index([userId, facilityId])
  @@index([clubSessionId, checkedOutAt])
}

model Club {
  id             String   @id @default(uuid())
  name           String
  description    String?
  inviteCode     String   @unique
  homeFacilityId String?
  // 월 회비 표준 금액 (KRW). null = 회비 기능 미사용. 회원별 실제 납부액은
  // DuesPayment.amount 가 우선하며, 없으면 이 값을 기대 금액으로 사용한다.
  // 정기 회비: monthlyDuesAmount = 주기당 청구액. 주기는 duesPeriodType 로 해석.
  monthlyDuesAmount Int?
  // 회비 주기: NONE | MONTHLY | QUARTERLY | HALF | YEARLY (문자열, 프로토타입).
  duesPeriodType String @default("NONE")
  // 정모별 참가비(번개비). null=미사용. 정모 참석 회차마다 청구.
  perSessionFee Int?
  // 게스트 기본 참가비. 게스트 등록 시 자동 청구.
  guestFee Int?
  // 회비/게스트비 입금 안내 계좌(자유 텍스트, 예: "카카오뱅크 3333-01-1234567 홍길동").
  // 반자동 정산: 청구 메시지에 넣어 회원이 여기로 송금 → 총무가 입금확인 원클릭.
  duesAccountInfo String?
  // 모임 공개 여부: PUBLIC = '모임 찾기'에 노출(게스트 신청 가능), PRIVATE = 숨김(기본).
  visibility String @default("PRIVATE")
  clubType String @default("CLUB") // CLUB(정기 클럽: 레슨·정기회비 등 풀기능) | MEETUP(번개 모임: 라이트)
  // 정기 운동 일정: [{day:0~6(일~토), start:"HH:mm", end:"HH:mm"}] — 안내 + 게스트
  // 신청 가능일 계산의 기준. null = 미설정(신청은 아무 날짜나, 기존 호환).
  weeklySchedule Json?
  // 게스트 신청 정책: 받기 토글 / 운동 시작 N시간 전 마감(null=시작 전까지) / 1일 정원(null=무제한).
  guestApplyEnabled Boolean @default(true)
  guestApplyDeadlineHours Int?
  contactInfo String? // 운영진 문의 채널(오픈채팅 링크·전화 등) — 게스트 신청 페이지 노출
  maxGuestsPerDay Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  homeFacility Facility?      @relation(fields: [homeFacilityId], references: [id])
  members      ClubMember[]
  sessions     ClubSession[]
  messages     ClubMessage[]
  duesPayments DuesPayment[]
  guestApplications GuestApplication[]
  lessonOffers LessonOffer[]
  guestThreads GuestThread[]
}

// 월 회비 납부 기록. (clubId, userId, period) 당 한 행 — 행이 있으면 그 달에
// 납부 완료. period 는 "YYYY-MM"(예: "2026-06"). amount 는 실제 납부액(보통
// Club.monthlyDuesAmount 와 같지만 회원별로 다를 수 있음). recordedById 는
// 납부 처리한 운영진. 미납 처리는 해당 행을 삭제하는 방식.
model DuesPayment {
  id           String   @id @default(uuid())
  clubId       String
  userId       String
  period       String // "YYYY-MM"
  amount       Int
  paidAt       DateTime @default(now())
  recordedById String

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId, period])
  @@index([clubId, period])
}

model ClubMember {
  id     String         @id @default(uuid())
  userId String
  clubId String
  role   ClubMemberRole @default(MEMBER)
  // Per-club 급수 override set by the club's operator (LEADER/STAFF). When
  // non-null it OVERRIDES the user's own default (PlayerProfile.skillLevel) FOR
  // THIS CLUB ONLY. Null = no override → fall back to the user's own default.
  skillLevel SkillLevel?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
}

// 모임 채팅/건의(짝 요청). 모임원이 남기는 메시지. type=REQUEST 는 "○○랑 같이
// 치고 싶어요 / 누구랑 짜주세요" 짝 요청 — mentionedUserIds 에 지목한 모임원 id.
model ClubMessage {
  id               String          @id @default(uuid())
  clubId           String
  userId           String
  text             String          @db.VarChar(500)
  type             ChatMessageType @default(CHAT)
  mentionedUserIds String[]        @default([])
  createdAt        DateTime        @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

// --- Turn (순번/고깔) system ---

model CourtTurn {
  id            String        @id @default(uuid())
  courtId       String
  position      Int // 1~maxTurnsPerCourt
  status        TurnStatus    @default(WAITING)
  gameType      CourtGameType @default(DOUBLES)
  createdById   String
  clubSessionId String?
  createdAt     DateTime      @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  timeLimitAt   DateTime?

  court           Court             @relation(fields: [courtId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("TurnCreator", fields: [createdById], references: [id])
  clubSession     ClubSession?      @relation(fields: [clubSessionId], references: [id])
  players         TurnPlayer[]
  game            Game?
  gameBoardEntry  GameBoardEntry?

  @@index([courtId, position])
  @@index([courtId, status])
  @@index([clubSessionId])
}

model TurnPlayer {
  id     String @id @default(uuid())
  turnId String
  userId String

  turn CourtTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([turnId, userId])
}

model Game {
  id        String     @id @default(uuid())
  turnId    String     @unique
  courtId   String
  status    GameStatus @default(IN_PROGRESS)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  turn          CourtTurn      @relation(fields: [turnId], references: [id], onDelete: Cascade)
  court         Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)
  players       GamePlayer[]
  noShowRecords NoShowRecord[]

  @@index([courtId])
}

model GamePlayer {
  id     String @id @default(uuid())
  gameId String
  userId String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
}

model NoShowRecord {
  id            String    @id @default(uuid())
  userId        String
  gameId        String
  facilityId    String
  occurredAt    DateTime  @default(now())
  penaltyEndsAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([userId, facilityId])
  @@index([userId, penaltyEndsAt])
}

model FacilitySession {
  id         String        @id @default(uuid())
  facilityId String
  openedById String
  status     SessionStatus @default(OPEN)
  openedAt   DateTime      @default(now())
  closedAt   DateTime?
  note       String?

  facility     Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  openedBy     User               @relation("SessionOpener", fields: [openedById], references: [id])
  clubSessions ClubSession[]

  @@index([facilityId, status])
}

model ScheduledJob {
  id        String   @id @default(uuid())
  type      String
  targetId  String
  executeAt DateTime
  executed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([executed, executeAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// --- Game Board (모임판) ---

enum GameBoardEntryStatus {
  QUEUED // 편성됨, 아직 코트에 안 걸림
  MATERIALIZED // CourtTurn으로 변환됨
  PLAYING // 게임 중
  COMPLETED // 완료
  CANCELLED // 취소
}

model GameBoard {
  id            String   @id @default(uuid())
  clubSessionId String   @unique
  facilityId    String
  createdById   String
  createdAt     DateTime @default(now())
  tagLayout     Json     @default("{}") // 모드2 자석판: { [userId]: { x, y } } 분수 좌표(운영진 공유)

  clubSession ClubSession      @relation(fields: [clubSessionId], references: [id])
  facility    Facility         @relation(fields: [facilityId], references: [id])
  createdBy   User             @relation("GameBoardCreator", fields: [createdById], references: [id])
  entries     GameBoardEntry[]
}

model GameBoardEntry {
  id         String               @id @default(uuid())
  boardId    String
  courtId    String?
  position   Int
  queueOrder Int                  @default(0) // global ordering of the court-less QUEUED queue (다음 게임 순서)
  note       String?
  playerIds  String[]
  status     GameBoardEntryStatus @default(QUEUED)
  turnId     String?              @unique
  createdAt  DateTime             @default(now())

  board GameBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  court Court?     @relation(fields: [courtId], references: [id])
  turn  CourtTurn? @relation(fields: [turnId], references: [id])

  @@index([boardId, position])
  @@index([boardId, queueOrder])
}

// --- Club Session (모임 세션) ---

model ClubSession {
  id                String            @id @default(uuid())
  clubId            String
  facilityId        String
  facilitySessionId String
  startedById       String
  status            ClubSessionStatus @default(ACTIVE)
  // 이 정모의 대관비(코트 대여 총액). 정산에서 참석자 수로 엔빵(1/N) 청구. null=미사용.
  rentalCost        Int?
  courtIds          String[]
  title             String?
  operatorMemo      String?           @db.Text // 운영자 공유 메모(실시간) — 여러 운영자 협업용
  scheduledStartAt  DateTime?
  checkInOpensAt    DateTime?
  checkInClosesAt   DateTime?
  startedAt         DateTime          @default(now())
  endedAt           DateTime?

  club            Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  facility        Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilitySession FacilitySession    @relation(fields: [facilitySessionId], references: [id], onDelete: Cascade)
  startedBy       User               @relation("ClubSessionStarter", fields: [startedById], references: [id])
  courts          Court[]
  turns           CourtTurn[]
  gameBoard       GameBoard?
  checkIns        CheckIn[]

  @@index([clubId, status])
  @@index([facilityId, status])
}

// 일단위 운영 지표 스냅샷(슈퍼관리자 대시보드용). 나중에 소급 계산이 불가능한
// 값(동시접속 피크·API 요청수)만 여기에 누적 기록한다. DAU·정모·체크인·게임 같은
// 활동량은 기존 타임스탬프로 조회 시 계산하므로 저장하지 않는다.
// date 는 서버 로컬(KST) 기준 "YYYY-MM-DD" 문자열 — 하루 버킷 키.
model DailyMetric {
  id              String   @id @default(uuid())
  date            String   @unique
  peakConnections Int      @default(0) // 하루 중 최대 동시 소켓 연결(피크)
  requestCount    Int      @default(0) // 하루 API 요청 수(누적)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 게스트 사전 신청(실험실 프로토타입) — 비회원이 공개 링크로 미리 신청 →
// 입금 안내 → 운영자가 입금확인 → 확정. 현장 QR 체크인과 별개의 "사전" 단계.
model GuestApplication {
  id        String   @id @default(uuid())
  clubId    String
  name      String
  // 앱 회원이 로그인 상태로 신청하면 계정을 연결(운영자에게 '앱 회원' 표시).
  userId    String?
  // 표준 신청 항목: 급수(S~F)·성별(M/F)·참석 희망일(YYYY-MM-DD). 연락처는 부가(선택).
  skillLevel String?
  gender     String?
  visitDate  String?
  phone     String?
  note      String?
  status    String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  feeAmount Int?
  feePaid   Boolean  @default(false)
  // 당일 체크인과 자동 매칭 — 신청자가 실제로 왔는지(노쇼 파악).
  checkedInAt DateTime?
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
}

// 레슨 중개 MVP — 모임 내 레슨 운영(마켓플레이스 아님).
// 운영진이 레슨 상품(코치·요일·시간·레슨비·정원)을 열고, 앱 회원이 신청하면
// 운영진이 확정한다. 정산 합산·수수료는 후속.
model LessonOffer {
  id          String   @id @default(uuid())
  clubId      String
  coachName   String
  coachIntro  String? // 한 줄 소개("전 실업팀 선수 출신")
  coachCareer String? // 이력·경력(줄바꿈 구분)
  day         Int // 정렬용 첫 요일 0(일)~6(토)
  days        Json? // 레슨 요일 묶음 [1,3,5]=월수금 — 없으면 [day]
  start       String // "HH:mm"
  end         String // "HH:mm"
  fee         Int? // 월 레슨비(안내용)
  capacity    Int? // 정원(null=무제한)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  club         Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  applications LessonApplication[]

  @@index([clubId])
}

model LessonApplication {
  id        String   @id @default(uuid())
  offerId   String
  userId    String?
  name      String
  phone     String?
  note      String?
  status    String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  feePaid   Boolean  @default(false) // 레슨비 입금확인(운영자 토글)
  createdAt DateTime @default(now())

  offer LessonOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, createdAt])
}

// 게스트 문의 채팅 — 비회원(익명)/앱 회원 게스트와 운영진 간 1:1 스레드.
// thread.id 자체가 익명 게스트의 접근 토큰(UUID, 추측 불가) 역할을 한다.
// 앱 회원 게스트는 guestUserId로 묶여 기기가 바뀌어도 이어진다.
model GuestThread {
  id            String   @id @default(uuid())
  clubId        String
  guestUserId   String? // 앱 회원 게스트면 그 userId(기기 무관 지속)
  guestName     String? // 표시용 이름
  lastMessageAt DateTime @default(now())
  lastText      String?  @db.VarChar(200) // 목록 미리보기용
  guestUnread   Int      @default(0) // 게스트가 안 읽은 수
  staffUnread   Int      @default(0) // 운영진이 안 읽은 수
  closed        Boolean  @default(false)
  createdAt     DateTime @default(now())

  club     Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  messages GuestMessage[]

  @@index([clubId, lastMessageAt])
  @@index([guestUserId])
}

model GuestMessage {
  id         String   @id @default(uuid())
  threadId   String
  fromStaff  Boolean // true=운영진, false=게스트
  userId     String? // 작성자 userId(운영진, 또는 앱 회원 게스트)
  authorName String
  text       String   @db.VarChar(1000)
  createdAt  DateTime @default(now())

  thread GuestThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}
