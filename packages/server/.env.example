DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB
JWT_SECRET=change-me-strong-secret
JWT_REFRESH_SECRET=change-me-strong-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3100
NODE_ENV=development

# ── (선택) 솔라피 SMS — 운영진 승급 문자 알림 ──
# 셋 다 있어야 문자 발송이 켜진다. 없으면 문자만 스킵되고 인앱 푸시는 정상 동작.
# 프로덕션은 GitHub Secrets(SOLAPI_API_KEY/SOLAPI_API_SECRET/SOLAPI_SENDER) → deploy.yml 이 .env.prod 에 주입.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=            # 솔라피에 사전등록한 발신번호 (예: 01012345678)

# 카카오 REST 키 — 장소검색 프록시(GET /facilities/search)용. 공개 키(클라 번들에도 있음).
KAKAO_REST_KEY=5a202bd90ab8dff01348f24cb1c37f3f
